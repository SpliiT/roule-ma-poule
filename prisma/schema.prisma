// prisma/schema.prisma

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  // extensions = [postgis]
}

// ============================================
// MODÈLES UTILISATEURS
// ============================================

model User {
  id        String   @id @default(cuid())
  clerkId   String   @unique
  email     String   @unique
  name      String?
  phone     String?
  role      UserRole @default(CLIENT)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Tracking Temps Réel (Techniciens)
  currentLat    Float?
  currentLng    Float?
  lastLocUpdate DateTime?

  // Relations
  addresses               Address[]
  bikes                   Bike[]
  clientInterventions     Intervention[]     @relation("ClientInterventions")
  technicianInterventions Intervention[]     @relation("TechnicianInterventions")
  technicianZones         TechnicianZone[]
  notifications           Notification[]

  @@index([clerkId])
  @@index([email])
}

enum UserRole {
  CLIENT
  TECHNICIEN
  ADMIN
}

// ============================================
// ADRESSES
// ============================================

model Address {
  id                String   @id @default(cuid())
  userId            String
  label             String?  // "Domicile", "Bureau", etc.
  street            String
  addressComplement String?
  postalCode        String
  city              String
  latitude          Float
  longitude         Float
  isDefault         Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ============================================
// VÉLOS
// ============================================

model Bike {
  id         String   @id @default(cuid())
  userId     String
  brand      String
  model      String
  year       Int?
  type       BikeType
  isElectric Boolean  @default(false)
  photoUrl   String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  interventions Intervention[]

  @@index([userId])
}

enum BikeType {
  CITY
  VTT
  ROAD
  GRAVEL
  BMX
  CARGO
  FOLDING
  OTHER
}

// ============================================
// ZONES GÉOGRAPHIQUES
// ============================================

model Zone {
  id          String   @id @default(cuid())
  name        String
  description String?
  geometry    String   @db.Text // GeoJSON ou WKT pour stockage des limites de zone
  color       String   @default("#3B82F6")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  technicians   TechnicianZone[]
  interventions Intervention[]
  plannings     Planning[]

  @@index([isActive])
}

model TechnicianZone {
  id           String   @id @default(cuid())
  technicianId String
  zoneId       String
  priority     Int      @default(1)
  createdAt    DateTime @default(now())

  technician User @relation(fields: [technicianId], references: [id], onDelete: Cascade)
  zone       Zone @relation(fields: [zoneId], references: [id], onDelete: Cascade)

  @@unique([technicianId, zoneId])
  @@index([zoneId])
}

// ============================================
// FORFAITS
// ============================================

model Forfait {
  id          String   @id @default(cuid())
  name        String
  description String   @db.Text
  duration    Int // en minutes
  price       Decimal  @db.Decimal(10, 2)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  interventions Intervention[]

  @@index([isActive])
}

// ============================================
// PRODUITS ADDITIONNELS
// ============================================

model Product {
  id          String   @id @default(cuid())
  name        String
  description String?  @db.Text
  price       Decimal  @db.Decimal(10, 2)
  stock       Int      @default(0)
  category    String?
  imageUrl    String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  interventionProducts InterventionProduct[]

  @@index([isActive])
  @@index([category])
}

// ============================================
// INTERVENTIONS
// ============================================

model Intervention {
  id                String             @id @default(cuid())
  clientId          String
  technicianId      String?
  zoneId            String?
  bikeId            String
  forfaitId         String

  // Adresse
  address           String
  addressComplement String?
  postalCode        String
  city              String
  latitude          Float
  longitude         Float

  // Planning
  scheduledAt       DateTime
  completedAt       DateTime?
  duration          Int // en minutes

  // Statut
  status            InterventionStatus @default(PENDING)

  // Détails
  trackingEnabled   Boolean            @default(false)
  clientNotes       String?            @db.Text
  technicianNotes   String?            @db.Text
  photos            String[] // URLs Cloudinary

  // Paiement
  totalPrice        Decimal            @db.Decimal(10, 2)
  isPaid            Boolean            @default(false)
  paidAt            DateTime?
  paymentMethod     String?

  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  client        User                       @relation("ClientInterventions", fields: [clientId], references: [id])
  technician    User?                      @relation("TechnicianInterventions", fields: [technicianId], references: [id])
  zone          Zone?                      @relation(fields: [zoneId], references: [id])
  bike          Bike                       @relation(fields: [bikeId], references: [id])
  forfait       Forfait                    @relation(fields: [forfaitId], references: [id])
  products      InterventionProduct[]
  statusHistory InterventionStatusHistory[]

  @@index([clientId])
  @@index([technicianId])
  @@index([zoneId])
  @@index([status])
  @@index([scheduledAt])
  @@index([latitude, longitude])
}

enum InterventionStatus {
  PENDING      // En attente de validation
  CONFIRMED    // Confirmée
  IN_PROGRESS  // En cours
  COMPLETED    // Terminée
  CANCELLED    // Annulée
}

model InterventionProduct {
  id             String  @id @default(cuid())
  interventionId String
  productId      String
  quantity       Int     @default(1)
  priceAtTime    Decimal @db.Decimal(10, 2)

  intervention Intervention @relation(fields: [interventionId], references: [id], onDelete: Cascade)
  product      Product      @relation(fields: [productId], references: [id])

  @@index([interventionId])
  @@index([productId])
}

model InterventionStatusHistory {
  id             String             @id @default(cuid())
  interventionId String
  status         InterventionStatus
  notes          String?            @db.Text
  createdAt      DateTime           @default(now())

  intervention Intervention @relation(fields: [interventionId], references: [id], onDelete: Cascade)

  @@index([interventionId])
}

// ============================================
// PLANNING
// ============================================

model Planning {
  id        String   @id @default(cuid())
  zoneId    String
  dayOfWeek Int // 0 = Dimanche, 1 = Lundi, etc.
  startTime String // Format "HH:MM"
  endTime   String // Format "HH:MM"
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  zone Zone @relation(fields: [zoneId], references: [id], onDelete: Cascade)

  @@index([zoneId])
  @@index([dayOfWeek])
}

// ============================================
// NOTIFICATIONS
// ============================================

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String   // BOOKING_CONFIRMED, INTERVENTION_ASSIGNED, REMINDER, etc.
  title     String
  message   String   @db.Text
  isRead    Boolean  @default(false)
  data      Json?    // metadata (interventionId, etc.)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([createdAt])
}

// ============================================
// PARAMÈTRES DE L'APPLICATION
// ============================================

model CompanyInfo {
  id          String   @id @default(cuid())
  name        String
  description String?  @db.Text
  address     String?
  phone       String?
  email       String?
  website     String?
  logo        String?
  siret       String?
  updatedAt   DateTime @updatedAt
}
